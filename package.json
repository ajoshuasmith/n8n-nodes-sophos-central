{
	"name": "@joshuanode/n8n-nodes-sophos-central",
	"version": "0.2.0",
	"description": "n8n community node for Sophos Central (Firewall Management API)",
	"license": "MIT",
	"keywords": [
		"n8n-community-node-package",
		"sophos",
		"sophos-central",
		"firewall",
		"firmware"
	],
	"homepage": "https://github.com/ajoshuasmith/n8n-nodes-sophos-central",
	"author": {
		"name": "Joshua Smith",
		"email": "ajoshuasmith@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ajoshuasmith/n8n-nodes-sophos-central.git"
	},
	"bugs": {
		"url": "https://github.com/ajoshuasmith/n8n-nodes-sophos-central/issues"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"overrides": {
		"form-data": "4.0.4"
	},
	"engines": {
		"node": ">=18.17.0"
	},
	"scripts": {
		"build": "n8n-node build && cp nodes/SophosCentral/*.svg dist/nodes/SophosCentral/",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SophosCentralApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SophosCentral/SophosCentral.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"n8n-workflow": "*",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
